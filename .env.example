# ==============================================================================
# SecureCodeRAG - Environment Configuration Example
# ==============================================================================
# Copy this file to backend/.env before running Docker Compose or starting the backend:
#   copy .env.example backend\.env   (Windows CMD)
#   Copy-Item .env.example backend\.env  (PowerShell)

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Options:
#   - 'ollama' : Run locally with Ollama (recommended for privacy, offline, no API costs)
#   - 'gemini' : Use Google Gemini Flash/Pro API (requires GEMINI_API_KEY below)
#   - 'dummy'  : Fallback deterministic mode without live LLM inference
LLM_PROVIDER=ollama

# Model name:
# For Ollama: deepseek-coder-v2:16b (pulled via: ollama pull deepseek-coder-v2:16b)
# For Gemini: gemini-2.0-flash-exp (or gemini-1.5-pro)
LLM_MODEL=deepseek-coder-v2:16b

# ------------------------------------------------------------------------------
# Google Gemini API Key (Optional - only required if LLM_PROVIDER=gemini)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# Ollama Configuration (Required if LLM_PROVIDER=ollama)
# ------------------------------------------------------------------------------
# When running backend in Docker and Ollama on Windows host:
#   Use http://host.docker.internal:11434
# When running backend directly on host machine (outside Docker):
#   Use http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Embedding model for RAG vector index retrieval:
# Pulled via: ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# Vector Store & Retrieval Configuration
# ------------------------------------------------------------------------------
# Path where FAISS vector indices are stored (relative to backend execution directory)
VECTORSTORE_PATH=vectorstore

# Number of relevant document chunks retrieved per finding
TOP_K=4
